# ================================================
# SUPABASE POSTGRESQL - VARIABLES D'ENVIRONNEMENT
# ================================================
# Remplacez les valeurs ci-dessous par celles de votre projet Supabase
# Pour trouver ces valeurs : Dashboard Supabase → Connect → ORMs → Prisma

# Pooler URL (pour les requêtes runtime sur Vercel - port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&connect_timeout=15"

# Direct URL (pour les migrations Prisma - port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
